# Help Scout OAuth app credentials (client-credentials flow).
# Create the app under YOUR account so drafts are attributed to you:
# Help Scout → your avatar (top right) → Your Profile → My Apps → Create My App.
# The redirect URL field can be anything (it is unused by this flow).
HELPSCOUT_APP_ID=
HELPSCOUT_APP_SECRET=

# The working mailbox — required (find ids with `hs mailboxes`). The workspace
# operates on exactly one mailbox: every command refuses conversations outside
# it. Change this value here to switch mailboxes.
HELPSCOUT_MAILBOX_ID=
